# NetBird IP of THIS host (netbird status | grep "NetBird IP")
NETBIRD_IP=100.64.0.1
BRIDGE_PORT=18080
# Where the CrowdSec LAPI is published on this host
LAPI_TARGET=127.0.0.1:8080
# Optional metrics bridge (docker-compose.metrics.yml)
METRICS_BRIDGE_PORT=18081
CROWDSEC_NETWORK=netbird_netbird
CROWDSEC_METRICS_TARGET=crowdsec:6060
