<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS is strongly recommended. Cleartext is permitted only so the backend can be reached via a
     NetBird peer IP (traffic is then already encrypted by WireGuard); the setup screen warns about http://. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
</network-security-config>
